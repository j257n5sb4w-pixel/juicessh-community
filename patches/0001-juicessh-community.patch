diff -ruN --binary -x build dec.orig/res/xml/network_security_config.xml dec/res/xml/network_security_config.xml
--- dec.orig/res/xml/network_security_config.xml	1970-01-01 08:00:00.000000000 +0800
+++ dec/res/xml/network_security_config.xml	2026-11-08 21:10:08.483560200 +0800
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  The upstream build allowed cleartext HTTP everywhere. Everything this app
+  talks to is either SSH/SFTP/mosh over raw TCP (unaffected by this policy) or
+  HTTPS; the only http:// URLs it produces are handed to the external browser.
+  Keep TLS-only and trust the system store only.
+-->
+<network-security-config>
+    <base-config cleartextTrafficPermitted="false">
+        <trust-anchors>
+            <certificates src="system"/>
+        </trust-anchors>
+    </base-config>
+</network-security-config>
